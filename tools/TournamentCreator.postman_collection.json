{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
		"name": "TournamentCreator API (Dota 2 Engine)",
		"description": "Coleção profissional completa para teste dos endpoints do TournamentCreator.\n\nInstruções:\n1. Execute a requisição 'POST 1.1 Login (Admin)' na pasta '1. Autenticação & Perfil'.\n2. O script pós-execução irá salvar automaticamente o token JWT na variável {{token}}.\n3. Todas as demais requisições que exigem autenticação já herdam {{token}} automaticamente!",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5208",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "tournamentId",
			"value": "00000000-0000-0000-0000-000000000000",
			"type": "string"
		},
		{
			"key": "draftSessionId",
			"value": "00000000-0000-0000-0000-000000000000",
			"type": "string"
		},
		{
			"key": "invitationId",
