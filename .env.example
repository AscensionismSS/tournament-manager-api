# ==============================================================================
# Variáveis de Ambiente - Tournament Creator
# Copie este arquivo para .env na raiz do projeto antes de rodar o Docker Compose:
# cp .env.example .env
# ==============================================================================

# Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=TournamentEngineDb
POSTGRES_PORT=5432

# Portas dos Serviços
API_PORT=5000
ADMINER_PORT=8088

# Ambiente .NET (Production ou Development)
ASPNETCORE_ENVIRONMENT=Production

# Autenticação JWT (Em Produção, defina obrigatoriamente uma chave aleatória única de no mínimo 32 caracteres)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=TournamentCreator
JWT_AUDIENCE=TournamentCreatorApp
JWT_EXPIRY_MINUTES=43200

# CORS (origens permitidas separadas por vírgula)
CORS_ALLOWED_ORIGINS=https://tsurus-cup.pages.dev

# Swagger / OpenAPI interativo em Produção (true ou false)
SWAGGER_ENABLED=false

# Usuário SuperAdmin Inicial (Em Produção, defina obrigatoriamente uma senha forte diferente de Admin123!)
ADMIN_SEED_EMAIL=admin@tournament.local
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
