# ==============================================================================
# Variáveis de Ambiente - Tournament Creator
# Copie este arquivo para .env na raiz do projeto antes de rodar o Docker Compose:
# cp .env.example .env
# ==============================================================================

# Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=s3ver4lc4lam1ty
POSTGRES_DB=TournamentEngineDb
POSTGRES_PORT=5432

# Portas dos Serviços
API_PORT=5000
ADMINER_PORT=8088

# Ambiente .NET (Production ou Development)
ASPNETCORE_ENVIRONMENT=Production

# Autenticação JWT (A chave secreta deve possuir no mínimo 256 bits / 32 caracteres)
JWT_SECRET_KEY=TournamentCreatorSecretKeySuperSecureMinimum256BitsLong2026!
JWT_ISSUER=TournamentCreator
JWT_AUDIENCE=TournamentCreatorApp
JWT_EXPIRY_MINUTES=43200

# CORS (origens permitidas separadas por vírgula ou * para permitir qualquer origem)
CORS_ALLOWED_ORIGINS=*

# Swagger / OpenAPI interativo em Produção (true ou false)
SWAGGER_ENABLED=true

# Usuário SuperAdmin Inicial (criado automaticamente caso a tabela de usuários esteja vazia)
ADMIN_SEED_EMAIL=admin@tournament.local
ADMIN_SEED_PASSWORD=Admin123!
